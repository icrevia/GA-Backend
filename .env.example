# GamerzAdda Backend Environment Configuration Template
#
# Local development:
# 1) Copy this file to .env
# 2) Fill values
#
# Railway production:
# - Do NOT rely on .env
# - Set every variable below in Railway -> Service -> Variables

PROJECT_NAME="GamerzAdda"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=False

# SECURITY: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LOGIN SECURITY
ENABLE_LOGIN_IP_BLOCK=True
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_FAILURE_BLOCK_THRESHOLD=8
LOGIN_FAILURE_BLOCK_SECONDS=1800

# TELEGRAM SECURITY ALERTS
SECURITY_ALERTS_ENABLED=True
SECURITY_ALERT_ON_SUCCESS_LOGIN=True
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALERT_CHAT_ID="7678909729"

# TELEGRAM LEDGER BOT (withdrawal workflow)
# LEDGER_BOT: Telegram bot token that receives withdrawal action callbacks.
# LEDGER_ADMINS: Comma-separated Telegram user/chat IDs allowed to approve/reject.
LEDGER_BOT=""
LEDGER_ADMINS=""
LEDGER_WEBHOOK_SECRET=""

SECURITY_ALERT_TIMEOUT_SECONDS=3.0
ENABLE_IP_GEO_LOOKUP=True
IP_GEO_LOOKUP_TIMEOUT_SECONDS=2.0
ADMIN_BLOCK_LOGIN_ON_GEO_DENIED=True

# ADMIN PANEL LOGIN (Railway env source of truth)
# Phone-only admin login (identifier is optional fallback).
ADMIN_LOGIN_IDENTIFIER=""
ADMIN_LOGIN_PHONE="+911234567890"
ADMIN_LOGIN_TELEGRAM_CHAT_ID=""

# DEVELOPER PAGE OTP GATE
DEVELOPER_OTP_ENABLED=True
DEVELOPER_OTP_LENGTH=6
DEVELOPER_OTP_TTL_SECONDS=300
DEVELOPER_OTP_MAX_VERIFY_ATTEMPTS=5
DEVELOPER_OTP_RESEND_COOLDOWN_SECONDS=30
DEVELOPER_OTP_SESSION_TTL_SECONDS=1800
# Supports one or more Telegram chat IDs (comma-separated), e.g. "7391642692,7678909729"
DEVELOPER_OTP_TELEGRAM_CHAT_ID=""

# APP SETTINGS
APP_URL="https://your-backend-domain.up.railway.app"
ALLOWED_ORIGINS="https://your-admin-domain.up.railway.app,https://gamerzadda.com,https://www.gamerzadda.com"
SUPPORT_WHATSAPP_NUMBER="917890125311"

# DATABASE (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL="postgresql://user:password@host:5432/dbname"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# PAYMENT GATEWAYS (PAYU)
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""
PAYU_BASE_URL="https://secure.payu.in"
PAYU_MERCHANT_VPA=""

# PAYMENT GATEWAYS (RAZORPAY)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_API_BASE_URL="https://api.razorpay.com"

# PAYMENT GATEWAYS (CCAVENUE)
CCAVENUE_MERCHANT_ID=""
CCAVENUE_ACCESS_CODE=""
CCAVENUE_WORKING_KEY=""
CCAVENUE_WEB_BASE_URL="https://secure.ccavenue.com"
CCAVENUE_API_BASE_URL="https://api.ccavenue.com"

# PAYMENT GATEWAY (PAY0.SHOP)
PAY0_MERCHANT_KEY=""

# EMAIL OTP SMTP path removed.
EMAIL_OTP_ENABLED=False
