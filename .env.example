# ZexPlay Backend Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN THE VALUES

PROJECT_NAME="ZexPlay"
API_V1_STR="/api/v1"

# SECURITY: Generate a random 32-char string using `openssl rand -hex 32`
SECRET_KEY="your-super-secret-key-change-this"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days

# DATABASE (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zexplay_db"

# PAYMENT GATEWAYS (PAYU)
PAYU_MERCHANT_KEY="your_merchant_key"
PAYU_MERCHANT_SALT="your_merchant_salt"
PAYU_BASE_URL="https://test.payu.in" # Use https://secure.payu.in for prod
PAYU_MERCHANT_VPA="zexplay@ybl"

# PAYMENT GATEWAYS (RAZORPAY)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your_rzp_secret"

# APP SETTINGS
APP_URL="https://your-backend-domain.com"
ALLOWED_ORIGINS="http://localhost:3000,http://admin.zexplay.com"
