# ZexPlay Backend Environment Configuration Template
#
# Local development:
# 1) Copy this file to .env
# 2) Fill values
#
# Railway production:
# - Do NOT rely on .env
# - Set every variable below in Railway -> Service -> Variables

PROJECT_NAME="ZexPlay"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=False

# SECURITY: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LOGIN SECURITY
ENABLE_LOGIN_IP_BLOCK=True
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_FAILURE_BLOCK_THRESHOLD=8
LOGIN_FAILURE_BLOCK_SECONDS=1800

# TELEGRAM SECURITY ALERTS
SECURITY_ALERTS_ENABLED=True
SECURITY_ALERT_ON_SUCCESS_LOGIN=True
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALERT_CHAT_ID="7678909729"
SECURITY_ALERT_TIMEOUT_SECONDS=3.0

# APP SETTINGS
APP_URL="https://your-backend-domain.up.railway.app"
ALLOWED_ORIGINS="https://your-admin-domain.up.railway.app"

# DATABASE (PostgreSQL)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# PAYMENT GATEWAYS (PAYU)
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""
PAYU_BASE_URL="https://secure.payu.in"
PAYU_MERCHANT_VPA=""

# PAYMENT GATEWAYS (RAZORPAY)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_API_BASE_URL="https://api.razorpay.com"

# PAYMENT GATEWAYS (CCAVENUE)
CCAVENUE_MERCHANT_ID=""
CCAVENUE_ACCESS_CODE=""
CCAVENUE_WORKING_KEY=""
CCAVENUE_WEB_BASE_URL="https://secure.ccavenue.com"
CCAVENUE_API_BASE_URL="https://api.ccavenue.com"
